# ==============================
# Auth.js
# ==============================
# `openssl rand -base64 32` で生成
AUTH_SECRET=

# ==============================
# Vercel Postgres (本番)
# Vercel ダッシュボードから取得
# ==============================
POSTGRES_URL=
POSTGRES_PRISMA_URL=
POSTGRES_URL_NO_SSL=
POSTGRES_URL_NON_POOLING=
POSTGRES_USER=
POSTGRES_HOST=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=

# ==============================
# Upstash Redis (レート制限)
# Upstash ダッシュボードから取得
# ==============================
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ==============================
# Resend (メール送信)
# ==============================
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@yourdomain.com

# ==============================
# アプリ設定
# ==============================
NEXT_PUBLIC_APP_URL=http://localhost:3000
</parameter>
